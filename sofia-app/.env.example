# ─────────────────────────────────────────────────────────────────────────────
# SOFIA — environment variables
# Copy to .env.local (or run `npm run setup:env`, which also generates secrets).
# Never commit real values. In production, set them in your hosting provider.
# ─────────────────────────────────────────────────────────────────────────────

# development | test | staging | production — production enables strict checks
APP_ENV=development
# Public URL of the app (links in emails, cookie security). https in production.
# Unset on Vercel previews: the address of the previewed branch is used.
APP_URL=http://localhost:3000

# PostgreSQL. The role must NOT be superuser nor BYPASSRLS, otherwise tenant
# isolation by Row-Level Security is not enforced (checked by /api/health).
DATABASE_URL=postgres://sofia:sofia@localhost:5432/sofia_dev
DATABASE_POOL_MAX=10
# Optional direct connection used by `npm run db:migrate` instead of DATABASE_URL.
# On Neon, DATABASE_URL is the pooled address (-pooler) and this one the direct one.
DATABASE_MIGRATION_URL=
# Optional, only used by `npm run db:setup` to create the role and database.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres

# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts integration
# credentials at rest. Keep the old value in ENCRYPTION_KEY_PREVIOUS while rotating.
ENCRYPTION_KEY=
ENCRYPTION_KEY_PREVIOUS=

# Email: smtp (production), console (logs the email) or file (writes JSON files)
EMAIL_TRANSPORT=console
# smtp://user:pass@host:587 — Brevo, Resend, SES, Postmark… Local Mailpit: smtp://localhost:1025
SMTP_URL=
EMAIL_FROM="SOFIA <no-reply@example.com>"
EMAIL_OUTBOX_DIR=.mail-outbox

# debug | info | warn | error
LOG_LEVEL=info
# Trust X-Forwarded-For for client IPs (true behind Vercel / a reverse proxy)
TRUST_PROXY=true
# Self-service signup. false = establishments are onboarded by invitation only.
SIGNUP_ENABLED=true
# Show /design-system outside development (staging review)
SHOW_DESIGN_SYSTEM=false
# Optional bearer token unlocking detailed checks on /api/health
HEALTHCHECK_TOKEN=

# Self-hosting with several instances: a stable key shared by all instances
# (openssl rand -base64 32). Not needed on Vercel.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
